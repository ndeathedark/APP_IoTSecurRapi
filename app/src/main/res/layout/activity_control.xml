<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="30dp"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel de Control IoT"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginBottom="10dp" />

    <!-- Indicador de estado sincronizado con Firestore -->
    <TextView
        android:id="@+id/tvEstadoSirena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: Sincronizando..."
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnEncender"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Encender Sirena"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnApagar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Apagar Sirena"
        android:backgroundTint="#388E3C"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>